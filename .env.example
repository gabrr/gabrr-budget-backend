APP_ENV=local
AUTH_MODE=local
LOCAL_USER_EMAIL=gabe@example.test
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Max multipart upload size in MB (e.g. POST /agents/process-file)
MAX_FILE_UPLOAD_MB=10
OPENROUTER_API_KEY=sk-
GOOGLE_API_KEY=AI
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/acetate_dev
# App reads this URL; `make test` sets DATABASE_URL from Makefile DATABASE_URL_DEVTEST (same URL by default).

# Copy to `.env` in this directory. Local Postgres example (see plan).
DEFAULT_USER_ID=gabe
DEFAULT_ACCOUNT_ID=acct_1

# Local PDF storage (absolute or relative to cwd)
UPLOAD_DIR=data/uploads

# Agent Gateway → agent-normalizer ADK REST API (`make api`, default port 8001)
AGENT_BASE_URL=http://127.0.0.1:8001
AGENT_AUTH_MODE=none
ADK_APP_NAME=app
AGENT_TIMEOUT_SECONDS=300
